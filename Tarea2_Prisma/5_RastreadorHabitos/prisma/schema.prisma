// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Habito {
  id Int @id @default(autoincrement())
  nombre String
  meta String
  registros Registro[]
}

model Registro {
  id Int @id @default(autoincrement())
  idHabito Int 
  habito Habito @relation(fields: [idHabito], references: [id], onDelete: Cascade)
  fecha DateTime
  completado Boolean
}