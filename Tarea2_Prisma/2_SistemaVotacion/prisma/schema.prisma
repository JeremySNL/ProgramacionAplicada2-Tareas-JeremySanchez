// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Encuesta {
  id Int @id @default(autoincrement())
  pregunta String
  opciones Opcion[]
}

model Opcion {
  id Int @id @default(autoincrement())
  idEncuesta Int
  descripcion String
  votos Int
  encuesta Encuesta @relation(fields: [idEncuesta], references: [id], onDelete: Cascade)
}